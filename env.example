# Copy to .env and fill in
WC_DB_PATH=./data/weight.db
WC_API_HOST=127.0.0.1
WC_API_PORT=8765
WC_WEB_DIST=./web/dist

# Oura personal access token: https://cloud.ouraring.com/personal-access-tokens
OURA_TOKEN=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Nightly check-in local time (24h)
CHECKIN_HOUR=23
CHECKIN_MINUTE=0

# Program start date (YYYY-MM-DD) — anchors cumulative deficit
PROGRAM_START=2026-07-27

# Estimated maintenance kcal — recalibrated automatically after 14 days of data
MAINTENANCE_KCAL=2500

# Basal metabolic rate — used only for days without Oura data, to still show an "Out" number
BMR_KCAL=1700

# Tuya Smart / Smart Life scale integration
# Endpoints:
#   Central Europe: https://openapi.tuyaeu.com  ← Sweden/Nordic accounts
#   Western Europe: https://openapi-weaz.tuyaeu.com
#   Western America: https://openapi.tuyaus.com
#   India:          https://openapi.tuyain.com
TUYA_ENDPOINT=https://openapi.tuyaeu.com
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
# Owner user ID of the linked app account (find via the debug script)
TUYA_UID=

# Local LLM for meal estimation (Ollama). Install: https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Cloud fallback if Ollama unavailable (leave OPENAI_API_KEY empty to disable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
