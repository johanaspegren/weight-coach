[Unit]
Description=weight-coach Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/dev/weight-coach
ExecStartPre=/usr/bin/mkdir -p /home/pi/dev/weight-coach/.run
ExecStart=/home/pi/dev/weight-coach/api/.venv/bin/python -m weight_coach.bot
StandardOutput=append:/home/pi/dev/weight-coach/.run/bot.log
StandardError=append:/home/pi/dev/weight-coach/.run/bot.log
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
