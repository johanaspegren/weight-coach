[Unit]
Description=weight-coach API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/dev/weight-coach
ExecStartPre=/usr/bin/mkdir -p /home/pi/dev/weight-coach/.run
ExecStart=/home/pi/dev/weight-coach/api/.venv/bin/uvicorn weight_coach.main:app --host 0.0.0.0 --port 8765
StandardOutput=append:/home/pi/dev/weight-coach/.run/api.log
StandardError=append:/home/pi/dev/weight-coach/.run/api.log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
