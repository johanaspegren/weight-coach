[Unit]
Description=weight-coach worker (APScheduler: Oura/Garmin/Tuya sync + nightly push)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/dev/weight-coach
ExecStartPre=/usr/bin/mkdir -p /home/pi/dev/weight-coach/.run
ExecStart=/home/pi/dev/weight-coach/api/.venv/bin/python -m weight_coach.worker
StandardOutput=append:/home/pi/dev/weight-coach/.run/worker.log
StandardError=append:/home/pi/dev/weight-coach/.run/worker.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
