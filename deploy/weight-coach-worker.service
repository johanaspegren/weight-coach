[Unit]
Description=weight-coach worker (APScheduler: Oura sync + nightly push)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/dev/weight-coach
ExecStartPre=/usr/bin/mkdir -p %h/dev/weight-coach/.run
ExecStart=%h/dev/weight-coach/api/.venv/bin/python -m weight_coach.worker
StandardOutput=append:%h/dev/weight-coach/.run/worker.log
StandardError=append:%h/dev/weight-coach/.run/worker.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
